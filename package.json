{
  "name": "agent-term",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that hosts virtual terminal sessions and reports changes as writing or drawing",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "life": "tsx fixtures/life/index.ts",
    "mcp": "tsx scripts/mcp-stdio.ts",
    "mcp:http": "tsx scripts/mcp-http.ts",
    "mcp:dev": "tsx watch scripts/mcp-http.ts",
    "test": "tsx --test test/*.test.ts corpus/test/*.test.ts",
    "test:unit": "tsx --test test/classify.test.ts test/screen.test.ts test/keys.test.ts test/edit-record.test.ts test/text-log.test.ts test/delta.test.ts test/history.test.ts test/history-corpus.test.ts test/corpus.test.ts",
    "record": "tsx corpus/scripts/record.ts",
    "record:all": "tsx corpus/scripts/record.ts --feed both",
    "corpus": "tsx scripts/corpus-score.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
